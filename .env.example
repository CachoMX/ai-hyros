# Nothing here is REQUIRED. A fresh deployment needs only the Upstash for
# Redis store (Vercel -> Storage -> Create Database -> Upstash for Redis,
# then redeploy). The first load then asks for your HYROS API
# key and a dashboard password on one screen. Env vars never decide whether
# the dashboard is set up.

# ---- Snapshot persistence (Upstash Redis) — injected by Vercel ----
# Either naming convention works; you do not need to rename anything.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or the marketplace names:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional hardening (both are generated on first load and shown in
#      the setup screen; paste them here to move them out of the database) ----
# Encrypts stored HYROS API keys at rest (AES-256-GCM).
ACCOUNT_KEY_SECRET=
# Signs the daily cron. Without it the cron is recognised by its user agent
# and limited to one run per hour.
CRON_SECRET=

# ---- Optional master password / overrides ----
# Accepted IN ADDITION to the password created on first load (recovery only).
REPORT_PASSWORD=
# The MCP endpoint is built in (https://mcp.hyros.com/mcp); override for staging/mocks.
HYROS_MCP_URL=
# Scale Advisor CAC ceiling at the ad-account level: optional, no default
# (LTV break-even is used when absent). Then snapshot defaults.
HYROS_CAC_CEILING=
HYROS_ATTRIBUTION_MODEL=LAST_CLICK
HYROS_AD_ACCOUNTS=
